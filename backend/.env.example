PORT=3000
# Browser origin allowed to call the API (Angular dev server)
CORS_ORIGIN=http://localhost:4200

# MySQL (same values as the root docker-compose.yml defaults)
DB_HOST=localhost
DB_PORT=3306
DB_USER=todo
DB_PASSWORD=todo
DB_NAME=todo

# MongoDB (same credentials as the root docker-compose.yml defaults)
MONGO_URL=mongodb://todo:todo@localhost:27017/?authSource=admin
MONGO_DB_NAME=todo

# Session (JWT). Development value only: in production use a long random secret, e.g.
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64'))"
JWT_SECRET=dev-only-secret-change-me-in-production-0123456789
JWT_EXPIRES_IN=8h

# Login failures and sign-ups allowed per IP per minute (then 429)
AUTH_ATTEMPTS_PER_MINUTE=5
# Proxies in front of the API: 0 here (no proxy), 1 in Docker (nginx), a list of networks on Render (see render.yaml)
# (trust every private hop, however many)
TRUST_PROXY=0
